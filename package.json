{
  "name": "@sundoge/kysely-d1",
  "version": "0.2.0",
  "description": "Kysely dialect for Cloudflare D1",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "kysely",
    "cloudflare",
    "d1",
    "query-builder"
  ],
  "scripts": {
    "build": "tsup",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "kysely": "^0.29.2",
    "@cloudflare/workers-types": "^4.0.0",
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@cloudflare/workers-types": "^4.20260621.1",
    "@types/bun": "latest",
    "kysely": "^0.29.2",
    "miniflare": "^4.20260617.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
