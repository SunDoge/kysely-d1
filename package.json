{
  "name": "@sundoge/kysely-d1",
  "version": "0.3.0",
  "description": "Kysely dialect for Cloudflare D1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SunDoge/kysely-d1.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "kysely",
    "cloudflare",
    "d1",
    "query-builder"
  ],
  "scripts": {
    "build": "tsdown",
    "ci": "biome ci .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "publint": "publint",
    "attw": "attw --pack .",
    "check": "biome check --write .",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "kysely": "^0.29.2",
    "@cloudflare/workers-types": "^4.0.0",
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.0",
    "@cloudflare/workers-types": "^4.20260621.1",
    "@types/bun": "latest",
    "kysely": "^0.29.2",
    "miniflare": "^4.20260617.1",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
